-- ============================================
-- GERENCIADOR DE CAPTURA E RENDERING DINÂMICO
-- ============================================
local activeEquippedId = nil

local function RefreshUI()
    -- Limpa os elementos visuais atuais
    for _, item in pairs(hotbarFrame:GetChildren()) do
        if item:IsA("TextButton") then item:Destroy() end
    end
    for _, item in pairs(scrollFrame:GetChildren()) do
        if item:IsA("TextButton") then item:Destroy() end
    end

    -- Renderiza APENAS os slots que possuem Tools filhas registradas (máximo 3)
    local slotCount = #Adapter.HotbarSlots
    
    if slotCount > 0 then
        -- Recalcula o tamanho e posição do container para centralizar perfeitamente
        local totalWidth = (slotCount * 65) + ((slotCount - 1) * 6)
        hotbarFrame.Size = UDim2.new(0, totalWidth, 0, 68)
        hotbarFrame.Position = UDim2.new(0.5, -math.floor(totalWidth / 2), 1, -78)

        for i = 1, slotCount do
            local toolData = Adapter.HotbarSlots[i]
            if toolData then
                local slotBtn = Instance.new("TextButton")
                slotBtn.Size = UDim2.new(0, 65, 0, 65)
                slotBtn.BackgroundColor3 = (activeEquippedId == toolData.Id) and Color3.fromRGB(50, 50, 50) or Color3.fromRGB(0, 0, 0)
                slotBtn.Text = toolData.Title or ""
                slotBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                slotBtn.Font = Enum.Font.SpecialElite
                slotBtn.TextSize = 10
                slotBtn.TextWrapped = true
                slotBtn.LayoutOrder = i
                slotBtn.Parent = hotbarFrame

                local stroke = Instance.new("UIStroke")
                stroke.Color = Color3.fromRGB(255, 255, 255)
                stroke.Thickness = 2
                stroke.Parent = slotBtn

                slotBtn.MouseButton1Click:Connect(function()
                    if activeEquippedId == toolData.Id then
                        activeEquippedId = nil
                        if toolData.OnUnequip then toolData.OnUnequip() end
                    else
                        if activeEquippedId and Adapter.RegisteredTools[activeEquippedId] then
                            local prev = Adapter.RegisteredTools[activeEquippedId]
                            if prev.OnUnequip then prev.OnUnequip() end
                        end
                        activeEquippedId = toolData.Id
                        if toolData.OnEquip then toolData.OnEquip() end
                    end
                    RefreshUI()
                end)
            end
        end
    else
        hotbarFrame.Size = UDim2.new(0, 0, 0, 68)
    end

    -- Renderiza itens no painel da Mochila
    for id, toolData in pairs(Adapter.RegisteredTools) do
        local toolCard = Instance.new("TextButton")
        toolCard.Size = UDim2.new(0, 65, 0, 65)
        toolCard.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        toolCard.Text = toolData.Title or ""
        toolCard.TextColor3 = Color3.fromRGB(255, 255, 255)
        toolCard.Font = Enum.Font.SpecialElite
        toolCard.TextSize = 10
        toolCard.TextWrapped = true
        toolCard.Parent = scrollFrame

        local cardStroke = Instance.new("UIStroke")
        cardStroke.Color = Color3.fromRGB(255, 255, 255)
        cardStroke.Thickness = 1.5
        cardStroke.Parent = toolCard

        toolCard.MouseButton1Click:Connect(function()
            if mainPanel.Visible then
                local alreadyInHotbar = false
                for i = 1, #Adapter.HotbarSlots do
                    if Adapter.HotbarSlots[i] and Adapter.HotbarSlots[i].Id == id then
                        alreadyInHotbar = true
                        break
                    end
                end

                if not alreadyInHotbar then
                    if #Adapter.HotbarSlots < 3 then
                        table.insert(Adapter.HotbarSlots, toolData)
                    else
                        Adapter.HotbarSlots[3] = toolData
                    end
                    RefreshUI()
                end
            end
        end)
    end
end

function Adapter:RegisterTool(toolData)
    Adapter.RegisteredTools[toolData.Id] = toolData
    
    -- Adiciona na Hotbar apenas se houver menos de 3 slots preenchidos
    if #Adapter.HotbarSlots < 3 then
        table.insert(Adapter.HotbarSlots, toolData)
    end
    RefreshUI()
end

toggleBackpackBtn.MouseButton1Click:Connect(function()
    mainPanel.Visible = not mainPanel.Visible
end)

for _, pendingTool in ipairs(Adapter.Queue) do
    Adapter:RegisterTool(pendingTool)
end
Adapter.Queue = {}

RefreshUI()
