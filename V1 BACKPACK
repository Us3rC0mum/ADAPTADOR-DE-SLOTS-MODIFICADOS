-- ATUALIZADOR E RE-RENDERIZADOR DA UI
function Adapter:RefreshUI()
    -- Calcula quantos slots estão atualmente ocupados
    local lastOccupied = 0
    for i = 1, MAX_SLOTS do
        if Adapter.HotbarSlots[i] ~= nil then
            lastOccupied = i
        end
    end

    -- Se estiver arrastando, libera visualmente o próximo slot vazio (máximo 3)
    local visibleLimit = lastOccupied
    if Adapter.IsDragging then
        visibleLimit = math.min(MAX_SLOTS, math.max(1, lastOccupied + 1))
    end

    for i = 1, MAX_SLOTS do
        local slotContainer = hotbarSlotFrames[i]
        
        -- Limpa elementos que não pertencem ao layout
        for _, child in pairs(slotContainer:GetChildren()) do
            if child:IsA("GuiObject") and not child:IsA("UIStroke") and not child:IsA("UICorner") then
                child.Parent = nil
            end
        end

        local toolData = Adapter.HotbarSlots[i]
        if toolData and toolData.ButtonUI then
            toolData.ButtonUI.Size = UDim2.new(1, 0, 1, 0)
            toolData.ButtonUI.Position = UDim2.new(0, 0, 0, 0)
            toolData.ButtonUI.Parent = slotContainer
            slotContainer.Visible = true
        else
            -- Mantém o slot visível apenas se estiver dentro do limite calculado
            slotContainer.Visible = (i <= visibleLimit)
        end
    end

    -- Atualiza o inventário da mochila
    for _, child in pairs(scrollFrame:GetChildren()) do
        if child:IsA("GuiObject") and not child:IsA("UIGridLayout") then
            child.Parent = nil
        end
    end

    for id, toolData in pairs(Adapter.RegisteredTools) do
        local inHotbar = false
        for i = 1, MAX_SLOTS do
            if Adapter.HotbarSlots[i] and Adapter.HotbarSlots[i].Id == id then
                inHotbar = true
                break
            end
        end

        if not inHotbar and toolData.ButtonUI then
            toolData.ButtonUI.Size = UDim2.new(0, 65, 0, 65)
            toolData.ButtonUI.Position = UDim2.new(0, 0, 0, 0)
            toolData.ButtonUI.Parent = scrollFrame
        end
    end
end

-- LÓGICA DE ARRASTO (DRAG & DROP)
local function SetupDragAndDrop(toolData)
    local btn = toolData.ButtonUI
    if not btn then return end

    local isDragging = false
    local dragProxy = nil
    local dragConn = nil
    local startPos = nil
    local dragThreshold = 8

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startPos = UserInputService:GetMouseLocation()

            dragConn = RunService.RenderStepped:Connect(function()
                local mPos = UserInputService:GetMouseLocation()

                if not isDragging and startPos and (mPos - startPos).Magnitude > dragThreshold then
                    isDragging = true
                    Adapter.IsDragging = true
                    Adapter:RefreshUI()

                    dragProxy = btn:Clone()
                    dragProxy.Size = UDim2.new(0, 65, 0, 65)
                    dragProxy.AnchorPoint = Vector2.new(0.5, 0.5)
                    dragProxy.ZIndex = 100
                    dragProxy.BackgroundTransparency = 0.2
                    dragProxy.Parent = screenGui
                end

                if isDragging and dragProxy then
                    dragProxy.Position = UDim2.new(0, mPos.X, 0, mPos.Y - 36)
                end
            end)
        end
    end)

    local function FinalizarArrasto()
        if dragConn then
            dragConn:Disconnect()
            dragConn = nil
        end

        if isDragging then
            isDragging = false
            Adapter.IsDragging = false

            if dragProxy then
                dragProxy:Destroy()
                dragProxy = nil
            end

            local mousePos = UserInputService:GetMouseLocation()

            local targetSlotIndex = nil
            for i = 1, MAX_SLOTS do
                local slotFrame = hotbarSlotFrames[i]
                if slotFrame.Visible then
                    local pos = slotFrame.AbsolutePosition
                    local size = slotFrame.AbsoluteSize

                    if mousePos.X >= pos.X and mousePos.X <= pos.X + size.X and
                       mousePos.Y >= pos.Y and mousePos.Y <= pos.Y + size.Y then
                        targetSlotIndex = i
                        break
                    end
                end
            end

            local currentSlotIndex = nil
            for i = 1, MAX_SLOTS do
                if Adapter.HotbarSlots[i] and Adapter.HotbarSlots[i].Id == toolData.Id then
                    currentSlotIndex = i
                    break
                end
            end

            if targetSlotIndex then
                if currentSlotIndex then
                    local itemNoAlvo = Adapter.HotbarSlots[targetSlotIndex]
                    Adapter.HotbarSlots[targetSlotIndex] = toolData
                    Adapter.HotbarSlots[currentSlotIndex] = itemNoAlvo
                else
                    Adapter.HotbarSlots[targetSlotIndex] = toolData
                end
            else
                local mainPos = mainPanel.AbsolutePosition
                local mainSize = mainPanel.AbsoluteSize
                local dentroDaMochila = (mousePos.X >= mainPos.X and mousePos.X <= mainPos.X + mainSize.X and
                                        mousePos.Y >= mainPos.Y and mousePos.Y <= mainPos.Y + mainSize.Y)

                if dentroDaMochila or not mainPanel.Visible then
                    if currentSlotIndex then
                        Adapter.HotbarSlots[currentSlotIndex] = nil
                    end
                end
            end

            Adapter:RefreshUI()
        end

        startPos = nil
    end

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            FinalizarArrasto()
        end
    end)
end

function Adapter:RegisterTool(toolData)
    Adapter.RegisteredTools[toolData.Id] = toolData
    SetupDragAndDrop(toolData)
    Adapter:RefreshUI()
end

