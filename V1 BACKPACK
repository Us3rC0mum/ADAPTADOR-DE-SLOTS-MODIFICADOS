-- GERENCIADOR DE RE-PARENTING SEM ALTERAR DESIGN
local function RefreshUI()
    -- Limpa containers sem destruir as UIs originais das Tools
    for _, item in pairs(hotbarFrame:GetChildren()) do
        if item:IsA("Frame") or item:IsA("GuiObject") then item.Parent = nil end
    end
    for _, item in pairs(scrollFrame:GetChildren()) do
        if item:IsA("GuiObject") and not item:IsA("UIGridLayout") then item.Parent = nil end
    end

    -- Renderiza APENAS os slots ativos na Hotbar
    local slotCount = #Adapter.HotbarSlots
    if slotCount > 0 then
        local totalWidth = (slotCount * 65) + ((slotCount - 1) * 6)
        hotbarFrame.Size = UDim2.new(0, totalWidth, 0, 68)
        hotbarFrame.Position = UDim2.new(0.5, -math.floor(totalWidth / 2), 1, -78)

        for i = 1, math.min(slotCount, 3) do
            local toolData = Adapter.HotbarSlots[i]
            if toolData and toolData.ButtonUI then
                local btn = toolData.ButtonUI
                btn.Size = UDim2.new(0, 65, 0, 65)
                btn.Position = UDim2.new(0, 0, 0, 0)
                btn.Parent = hotbarFrame
            end
        end
    else
        hotbarFrame.Size = UDim2.new(0, 0, 0, 68)
    end

    -- Renderiza no grid do Project Backpack o que não estiver na Hotbar (ou todos para troca)
    for id, toolData in pairs(Adapter.RegisteredTools) do
        local alreadyInHotbar = false
        for _, hTool in ipairs(Adapter.HotbarSlots) do
            if hTool.Id == id then
                alreadyInHotbar = true
                break
            end
        end

        if not alreadyInHotbar and toolData.ButtonUI then
            local btn = toolData.ButtonUI
            btn.Size = UDim2.new(0, 65, 0, 65)
            btn.Position = UDim2.new(0, 0, 0, 0)
            btn.Parent = scrollFrame
        end
    end
end

function Adapter:RegisterTool(toolData)
    Adapter.RegisteredTools[toolData.Id] = toolData
    -- Não coloca direto na Hotbar; fica apenas disponível na Mochila
    RefreshUI()
end

toggleBackpackBtn.MouseButton1Click:Connect(function()
    mainPanel.Visible = not mainPanel.Visible
end)

for _, pendingTool in ipairs(Adapter.Queue) do
    Adapter:RegisterTool(pendingTool)
end
Adapter.Queue = {}

RefreshUI()
